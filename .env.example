# Bu dosyayı .env olarak kopyala ve değerleri doldur. .env dosyasını asla git'e ekleme.

# Zorunlu ------------------------------------------------------------
# Oturum ve CSRF imzaları için. Üret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Canonical, sitemap ve paylaşım bağlantıları için gerçek adres (sonunda / yok)
SITE_URL=https://ornek.com

# İsteğe bağlı -------------------------------------------------------
PORT=3000
DATABASE_PATH=data/app.db
# Cloudflare arkasında: cf-connecting-ip  |  Nginx arkasında: x-forwarded-for  |  doğrudan: boş bırak
TRUST_PROXY_HEADER=

# Yeni talep e-posta bildirimi (resend.com). İkisi de yoksa bildirim gönderilmez.
RESEND_API_KEY=
MAIL_FROM="Platform <bildirim@ornek.com>"

# Cloudflare Turnstile bot koruması. İkisi de yoksa kapalıdır (bal küpü + süre + hız sınırı yine aktif).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
